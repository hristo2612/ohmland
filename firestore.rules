rules_version = '2';

/*
 * Ohmland's Firestore: one document per signed-in learner, learners/{uid}, and nothing else.
 *
 * Only its owner reads, writes or deletes it, and only an account made with Google or GitHub (so turning on another
 * sign-in method by mistake, such as anonymous, opens nothing). Every write must have exactly the document's shape
 * (apps/web/src/account/remote.ts): known keys, typed values, ids of a known form, and every collection capped in count
 * and in characters, so a free account cannot use the database as storage. Rules cannot loop over a map or a list, so
 * each entry is a short packed string and a whole collection is checked at once: its strings joined by newlines must
 * match the entry pattern repeated, and splitting them again must give back exactly as many entries (no entry may hide
 * a newline). Worst case, a document stays well under Firestore's 1 MiB.
 *
 * The rules tests (apps/web/rules) hold each bound. Change remote.ts CAPS and PATTERNS together with these.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'github.com'];
    }

    /* Patterns. matches() always matches the whole string. */
    function ISO() { return '[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?Z'; }
    /* A content id (a lesson, an achievement): kebab-case, at most 80 characters. */
    function ID() { return '[a-z0-9][a-z0-9-]{0,79}'; }
    function TASK() { return '[A-Za-z0-9][A-Za-z0-9_-]{0,63}'; }
    function KIND() { return '[a-z0-9][a-z0-9-]{0,39}'; }
    function SAVE_ID() { return '[A-Za-z0-9_-]{1,64}'; }
    /* <at>|<version 1-9999>|<firstTry 0-999>|<items 0-999>|<task>,<task>,... */
    function LESSON() { return ISO() + '[|][1-9][0-9]{0,3}[|][0-9]{1,3}[|][0-9]{1,3}[|](' + TASK() + '(,' + TASK() + ')*)?'; }
    /* <at>|<kind>|<lessonId or nothing>|<label, 1 to 80 characters> */
    function FRIED() { return ISO() + '[|]' + KIND() + '[|](' + ID() + ')?[|][^\n|]{1,80}'; }
    /* A saved bench: one line of JSON, an object. Its size is capped for the sandbox as a whole. */
    function BENCH() { return '[{][^\n]*[}]'; }

    /** Every string in `parts` matches `one`, and none hides a newline (which would let one entry pass as two). */
    function allMatch(parts, one) {
      let joined = parts.join('\n');
      return parts.size() == 0 || (joined.matches(one + '(\n' + one + ')*') && joined.split('\n').size() == parts.size());
    }

    function lessonsOk(m) {
      return m is map && m.size() <= 2000 && allMatch(m.keys(), ID()) && allMatch(m.values(), LESSON())
        && m.values().join('\n').size() <= 256000;
    }
    function achievementsOk(m) {
      return m is map && m.size() <= 500 && allMatch(m.keys(), ID()) && allMatch(m.values(), ISO());
    }
    function friedOk(l) {
      return l is list && l.size() <= 500 && allMatch(l, FRIED());
    }
    function sandboxOk(m) {
      return m is map && m.size() <= 50 && allMatch(m.keys(), SAVE_ID()) && allMatch(m.values(), BENCH())
        && m.values().join('\n').size() <= 256000;
    }
    function settingsOk(s) {
      return s is map && s.keys().hasOnly(['muted', 'reducedMotion', 'theme']) && s.keys().hasAll(['muted', 'reducedMotion', 'theme'])
        && s.muted is bool && s.reducedMotion in ['system', 'on', 'off'] && s.theme in ['system', 'light', 'dark'];
    }
    function learnerOk(d) {
      let keys = ['v', 'lessons', 'achievements', 'fried', 'sandbox', 'settings', 'updatedAt'];
      return d.keys().hasOnly(keys) && d.keys().hasAll(keys)
        && d.v is int && d.v == 1
        && d.updatedAt is string && d.updatedAt.matches(ISO())
        && lessonsOk(d.lessons) && achievementsOk(d.achievements) && friedOk(d.fried)
        && sandboxOk(d.sandbox) && settingsOk(d.settings);
    }

    match /learners/{uid} {
      // get, not read: no one can list the collection.
      allow get, delete: if owner(uid);
      allow create, update: if owner(uid) && learnerOk(request.resource.data);
    }
  }
}

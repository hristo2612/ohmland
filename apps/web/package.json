{
  "name": "@ohmland/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./lab": "./src/lab/define.ts"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:rules": "node scripts/emulators.mjs firestore -- vitest run --config vitest.rules.config.ts",
    "e2e": "playwright test",
    "e2e:accounts": "node scripts/emulators.mjs auth,firestore -- playwright test --config playwright.accounts.config.ts",
    "emulators": "firebase emulators:start --only auth,firestore,hosting --project ohmland",
    "deploy:rules": "firebase deploy --only firestore:rules --project ohmland",
    "lint:colors": "node scripts/check-colors.mjs",
    "shots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@fontsource/kalam": "5.3.0",
    "@fontsource/literata": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@ohmland/bench": "workspace:*",
    "@ohmland/code": "workspace:*",
    "@ohmland/isle": "workspace:*",
    "@ohmland/sim": "workspace:*",
    "astro": "7.3.8",
    "firebase": "12.19.0",
    "idb-keyval": "6.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "yaml": "2.9.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "firebase-tools": "15.31.0",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}

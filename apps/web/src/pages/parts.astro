---
import Page from "../layouts/Page.astro";
import PartsBin from "../parts/PartsBin";
import { getCourse } from "../content/load";
import { m } from "../i18n";

const course = getCourse();
---

<Page title={m.parts.title} active="parts">
  <div class="sheet">
    <div class="sheet__main">
      <header class="page-head">
        <h1>{m.parts.title}</h1>
        <p class="lead">{m.parts.lead}</p>
      </header>
      <PartsBin client:load parts={course.parts} outline={course.outline} />
    </div>
  </div>
</Page>

        <rect class="lp-b-brown" x="514" y="213.5" width="9" height="37"></rect>
        <rect class="lp-b-gold" x="547" y="213.5" width="7" height="37"></rect>
        <rect class="lp-ln" x="470" y="213" width="100" height="38" rx="17"></rect>
        <text class="lp-hand" x="520" y="190" text-anchor="middle" font-size="32">{L.resistor}</text>

        <path class="lp-lead" d="M1046 232V180M1074 232V184"></path>
        <path class="lp-led" d="M1012 164V98a48 48 0 0 1 96 0V164z"></path>
        <rect class="lp-led" x="1002" y="162" width="116" height="20" rx="2"></rect>
        <path class="lp-shine" d="M1030 104a26 26 0 0 1 18-24"></path>
        <g class="lp-rays"><path d="M1060 16V-6"></path><path d="M976 44l-16-16"></path><path d="M1144 44l16-16"></path><path d="M1166 110h24"></path><path d="M954 110h-24"></path></g>
        <circle class="lp-dot" cx="1046" cy="232" r="5"></circle><circle class="lp-dot" cx="1074" cy="232" r="5"></circle>


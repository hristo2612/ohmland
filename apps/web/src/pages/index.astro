        <g class="lp-rays lp-rays--narrow"><path d="M280 54V40"></path><path d="M234 74l-10-10"></path><path d="M326 74l10-10"></path><path d="M336 112h14"></path><path d="M224 112h-14"></path></g>
        <circle class="lp-dot" cx="270" cy="176" r="3.6"></circle><circle class="lp-dot" cx="290" cy="176" r="3.6"></circle>
        <use href="#lp-battery" x="6" y="600" width="88" height="123"></use>
        <ellipse class="lp-shade" cx="52" cy="734" rx="46" ry="4.5"></ellipse>
        <text class="lp-hand lp-hand--red" x="212" y="604" text-anchor="middle" font-size="20">{L.switchNote.join(" ")}</text>
        <g class="lp-flow lp-flow--narrow">
          <path class="up" d="M14 420V376M7 385l7-9 7 9"></path>
          <path class="right" d="M200 160H246M238 153l8 7-8 7"></path>
          <path class="down" d="M376 340V384M369 375l7 9 7-9"></path>
        </g>
      </svg>

      <div class="hero__robot" aria-hidden="true">
        <Mascot pose="idle" size={141} className="hero__robot-idle" />
        <Mascot pose="happy" size={141} className="hero__robot-happy" />
      </div>

      <div class="hero__copy">
        <h1 id="hero-title">{L.title}</h1>
        <p>{L.lead}</p>
      </div>

      <HeroActions client:load outline={course.outline} />
    </div>
  </section>

  <section class="journey container" aria-labelledby="journey-title">
    <h2 id="journey-title" class="journey__title">{L.journeyTitle}</h2>
    <div class="journey__route">
      <svg class="journey__wire" viewBox="0 0 1440 24" preserveAspectRatio="none" aria-hidden="true">
        <path class="lp-edge lp-edge--route" d="M0 12C240 10 480 14 720 12S1200 10 1440 12"></path>
        <path class="lp-core lp-core--pos lp-core--route" d="M0 12C240 10 480 14 720 12S1200 10 1440 12"></path>
      </svg>
      <ol class="journey__stations" style={`--n: ${units.length}`}>
        {
          units.map((u, i) => {
            const kind = DRAWING[u.id];
            return (
              <li class:list={["station", { "station--you": i === 0 }]}>
                <svg class="station__art" viewBox="0 0 200 200" aria-hidden="true">
                  {kind === "led" ? (
                    <>
                      <circle cx="100" cy="78" r="90" fill="url(#lp-glow)" />
                      <path class="lp-lead" d="M88 170V126M112 170V128" />
                      <path class="lp-led lp-led--lit" d="M72 116V68a28 28 0 0 1 56 0V116z" />
                      <rect class="lp-led lp-led--lit" x="64" y="112" width="72" height="14" rx="2" />
                      <path class="lp-shine" d="M84 70a16 16 0 0 1 10-14" />
                      <g class="lp-rays lp-rays--on">
                        <path d="M100 24V8" />
                        <path d="M52 44L40 32" />
                        <path d="M148 44l12-12" />
                        <path d="M160 84h16" />
                        <path d="M40 84H24" />
                      </g>
                      <circle class="lp-dot" cx="88" cy="170" r="4" />
                      <circle class="lp-dot" cx="112" cy="170" r="4" />
                    </>
                  ) : kind === "transistor" ? (
                    <>
                      <path class="lp-lead" d="M80 170V122M100 170V122M120 170V122" />
                      <path class="lp-chip lp-ln" d="M66 124V78a34 34 0 0 1 68 0V124z" />
                      <path class="lp-shine lp-shine--soft" d="M76 82a24 24 0 0 1 16-22" />
                      <text class="lp-hand lp-deco" x="100" y="30" text-anchor="middle" font-size="20">2N3904</text>
                      <circle class="lp-dot" cx="80" cy="170" r="4" />
                      <circle class="lp-dot" cx="100" cy="170" r="4" />
                      <circle class="lp-dot" cx="120" cy="170" r="4" />
                    </>
                  ) : kind === "solder" ? (
                    <>
                      <rect class="lp-r-body" x="40" y="118" width="120" height="44" rx="3" />
                      <path class="lp-thin" d="M40 162v8M160 162v8" />
                      <g class="lp-dot">
                        {[56, 72, 88, 104, 136, 152].map((x) => <circle cx={x} cy="130" r="2.4" />)}
                        {[56, 72, 104, 120, 136, 152].map((x) => <circle cx={x} cy="148" r="2.4" />)}
                      </g>
                      <ellipse class="lp-joint" cx="120" cy="130" rx="7" ry="5" />
                      <ellipse class="lp-joint" cx="88" cy="148" rx="7" ry="5" />
                      <path class="lp-ln" d="M124 124l34-58" />
                      <path class="lp-slip lp-ln" d="M154 72l10-18 6 3-10 18z" />
                      <path class="lp-chip lp-ln" d="M164 54l16-28a8 8 0 0 1 14 7l-16 28z" />
                      <path class="lp-smoke" d="M112 110c-8-8 6-14-2-24" />
                      <path class="lp-smoke" d="M100 112c-6-6 4-10-2-18" />
                    </>
                  ) : kind === "chip" ? (
                    <>
                      <path class="lp-lead" d="M64 140v30M88 140v14M112 140v14M136 140v30" />
                      <rect class="lp-chip lp-ln" x="50" y="94" width="100" height="48" rx="4" />
                      <path class="lp-slip lp-ln" d="M50 110a8 8 0 0 1 0 16" />
                      <text class="lp-chip-tx" x="104" y="126" text-anchor="middle" font-size="24">555</text>
                      <path class="lp-lead" d="M64 94V80M88 94V80M112 94V80M136 94V80" />
                      <circle class="lp-dot" cx="64" cy="170" r="4" />
                      <circle class="lp-dot" cx="136" cy="170" r="4" />
                    </>
                  ) : kind === "radio" ? (
                    <>
                      <path class="lp-ln" d="M140 92L170 20" />
                      <circle class="lp-dot" cx="171" cy="17" r="5" />
                      <rect class="lp-meter lp-ln" x="40" y="92" width="120" height="78" rx="10" />
                      <circle class="lp-slip lp-ln" cx="80" cy="131" r="24" />
                      <path class="lp-thin" d="M64 124h32M60 131h40M64 138h32" />
                      <circle class="lp-slip lp-ln" cx="132" cy="118" r="11" />
                      <path class="lp-ln" d="M132 118l6-6" />
                      <path class="lp-thin" d="M118 146h28M118 154h20" />
                      <path class="lp-waves" d="M28 108c-8 10-8 24 0 34M16 98c-14 16-14 38 0 54" />
                    </>
                  ) : (
                    <use href="#lp-battery" x="60" y="40" width="80" height="112" />
                  )}
                </svg>
                <p class="station__unit">
                  <span class="station__n">{u.number}</span>
                  {u.title}
                </p>
                {L.journey[u.id] && <p class="station__what">{L.journey[u.id]}</p>}
                {i === 0 && (
                  <p class="station__here" aria-hidden="true">
                    {L.youStart}
                    <svg viewBox="0 0 48 40" class="mark mark--blue">
                      <path d="M2 6C18 2 34 10 44 30" />
                      <path d="M34 28l10 4 2-11" />
                    </svg>
                  </p>
                )}
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>
</Page>

<script>
  // The switch: pointing at it or focusing it closes the loop. On a touch screen the loop closes by itself. Pressing it
  // turns the page over to the lesson (instantly under reduced motion).
  const stage = document.querySelector<HTMLElement>("[data-stage]");
  const root = document.documentElement;
  if (stage) {
    const touch = matchMedia("(hover: none)").matches;
    const isSwitch = (t: EventTarget | null) => t instanceof Element && !!t.closest("[data-switch]");
    const light = (on: boolean) => stage.classList.toggle("is-lit", on || touch);
    // fetch the lesson page early, so the page turn lands on it
    let fetched = false;
    const prefetch = () => {
      const href = stage.querySelector<HTMLAnchorElement>("a[data-switch]")?.href;
      if (fetched || !href) return;
      fetched = true;
      const hint = document.createElement("link");
      hint.rel = "prefetch";
      hint.href = href;
      document.head.append(hint);
    };
    stage.addEventListener("pointerover", (e) => {
      if (!isSwitch(e.target)) return;
      light(true);
      prefetch();
    });
    stage.addEventListener("pointerout", (e) => isSwitch(e.target) && !isSwitch(e.relatedTarget) && light(false));
    stage.addEventListener("focusin", (e) => {
      if (!isSwitch(e.target)) return;
      light(true);
      prefetch();
    });
    stage.addEventListener("focusout", (e) => isSwitch(e.target) && light(false));
    if (touch) setTimeout(() => light(true), root.dataset.motion === "reduce" ? 0 : 900);

    stage.addEventListener("click", (e) => {
      const link = e.target instanceof Element ? e.target.closest<HTMLAnchorElement>("a[data-switch]") : null;
      if (!link || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      light(true);
      if (root.dataset.motion === "reduce") return;
      e.preventDefault();
      // the token may come back as "440ms" or, minified, ".44s"
      const raw = getComputedStyle(root).getPropertyValue("--dur-turn").trim();
      const ms = (parseFloat(raw) || 0) * (raw.endsWith("ms") ? 1 : 1000);
      root.dataset.turning = "";
      setTimeout(() => location.assign(link.href), ms);
    });
    // Coming back to this page from the lesson (the back button) shows it again, untouched.
    addEventListener("pageshow", () => delete root.dataset.turning);
  }
</script>

        <rect class="lp-r-body lp-r-body--narrow" x="106" y="164" width="60" height="24" rx="11"></rect>
        <rect class="lp-b-yellow" x="114" y="164.5" width="6" height="23"></rect>
        <rect class="lp-b-violet" x="124" y="164.5" width="6" height="23"></rect>
        <rect class="lp-b-brown" x="134" y="164.5" width="6" height="23"></rect>
        <rect class="lp-b-gold" x="153" y="164.5" width="5" height="23"></rect>
        <rect class="lp-ln lp-ln--narrow" x="106" y="164" width="60" height="24" rx="11"></rect>

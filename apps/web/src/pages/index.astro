---
/**
 * The landing: one big hand-drawn circuit around one headline, open at a single button that is its switch. Pointing at
 * the switch (or focusing it) closes the loop: the LED lights and the current arrows run. On a touch screen the loop
 * closes by itself once the page is in. Pressing it turns the page over to the first lesson. Below, one quiet line of
 * drawings: the whole course on one wire.
 */
import Page from "../layouts/Page.astro";
import HeroActions from "../components/HeroActions";
import { Mascot } from "../mascot/Mascot";
import { getCourse } from "../content/load";
import { m } from "../i18n";
import "../styles/landing.css";

const course = getCourse();
const units = [
  ...course.units.map((u) => ({ id: u.id, number: u.number, title: u.title })),
  ...course.upcoming.map((u) => ({ id: u.id, number: u.number, title: u.title })),
];
/** Which drawing stands for which unit; a unit without its own drawing gets the battery. */
const DRAWING: Record<string, "led" | "transistor" | "solder" | "chip" | "radio"> = {
  basics: "led",
  switching: "transistor",
  permanent: "solder",
  chips: "chip",
  beyond: "radio",
};
const L = m.landing;
---

<Page bare bar={false}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__stage" data-stage>
      <svg class="hero__defs" aria-hidden="true" focusable="false">
        <defs>
          <pattern id="lp-hatch" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><path d="M0 0V5" class="lp-hatch"></path></pattern>
          <pattern id="lp-hatch-light" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><path d="M0 0V7" class="lp-hatch lp-hatch--light"></path></pattern>
          <radialGradient id="lp-glow"><stop offset="0" class="lp-glow-0"></stop><stop offset="0.35" class="lp-glow-1"></stop><stop offset="1" class="lp-glow-2"></stop></radialGradient>
          <symbol id="lp-battery" viewBox="0 0 112 156" overflow="visible">
            <rect x="104" y="22" width="8" height="128" fill="url(#lp-hatch)"></rect>
            <rect class="lp-slip" x="4" y="16" width="100" height="136" rx="5"></rect>
            <rect x="4" y="62" width="100" height="90" fill="url(#lp-hatch-light)"></rect>
            <rect class="lp-batt-label" x="4" y="62" width="100" height="40"></rect>
            <rect class="lp-ln" x="4" y="16" width="100" height="136" rx="5"></rect>
            <path class="lp-thin" d="M4 62h100M4 102h100"></path>
            <path class="lp-ln" d="M104 22l8 6v118l-8 4"></path>
            <text class="lp-batt-tx" x="54" y="91" text-anchor="middle">{L.battery}</text>
            <rect class="lp-slip lp-ln" x="16" y="4" width="24" height="12" rx="2"></rect>
            <path class="lp-slip lp-ln" d="M72 16V8l6-4h12l6 4v8"></path>
            <path class="lp-thin" d="M24 10h8M28 6v8"></path>
          </symbol>
        </defs>
      </svg>

      <!-- The desktop sheet: 1440 x 828 -->
      <svg class="hero__art hero__art--wide" viewBox="0 0 1440 828" role="img" aria-label={L.artLabel}>
        <g class="lp-glow"><circle cx="1060" cy="110" r="290" fill="url(#lp-glow)"></circle></g>

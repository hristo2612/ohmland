---
import Page from "../layouts/Page.astro";
import HeroActions from "../components/HeroActions";
import { IsleArt } from "../components/IsleArt";
import { Icon } from "../components/Icon";
import { Badge } from "../components/Badge";
import { Mascot } from "../mascot/Mascot";
import { PartIcon } from "../parts/PartIcon";
import { getCourse } from "../content/load";
import { m } from "../i18n";
import type { IconName } from "../components/icons";

const course = getCourse();
const howIcons: IconName[] = ["cursor", "hint", "target", "isle"];
const path = [
  ...course.units.map((u) => ({ number: u.number, title: u.title, summary: u.summary, open: true })),
  ...course.upcoming.map((u) => ({ number: u.number, title: u.title, summary: u.summary, open: false })),
];
const binParts = ["resistor", "led", "battery", "capacitor", "multimeter", "transistor"] as const;
---

<Page>
  <section class="hero">
    <div class="hero__inner container">
      <div class="hero__copy">
        <span class="eyebrow"><Icon name="spark" size={16} />{m.landing.eyebrow}</span>
        <h1 class="hero__title">
          {m.landing.titleStart}
          <span class="hero__title-accent">{m.landing.titleEnd}</span>
        </h1>
        <p class="hero__lead">{m.landing.lead}</p>
        <HeroActions client:load outline={course.outline} />
        <p class="hero__reassure small"><Icon name="device" size={16} />{m.landing.reassure}</p>
      </div>
      <figure class="hero__isle" data-isle-slot>
        <div class="hero__isle-glow" aria-hidden="true"></div>
        <IsleArt label={m.landing.isleLabel} className="hero__isle-art" />
        <div class="hero__mascot">
          <Mascot pose="happy" size={96} />
        </div>
        <figcaption class="small muted">{m.landing.isleCaption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="how container" aria-labelledby="how-title">
    <div class="section-head">
      <h2 id="how-title">{m.landing.howTitle}</h2>
      <p>{m.landing.howLead}</p>
    </div>
    <ol class="how__steps">
      {
        m.landing.how.map((step, i) => (
          <li class="how__step">
            <span class="how__num mono" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <span class="how__icon">
              <Icon name={howIcons[i] ?? "spark"} size={22} />
            </span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="features container" aria-labelledby="features-title">
    <div class="section-head">
      <h2 id="features-title">{m.landing.featuresTitle}</h2>
    </div>
    <div class="features__grid">
      <article class="feature card">
        <div class="feature__art feature__art--sim" aria-hidden="true">
          <div class="feature__glow"></div>
          <PartIcon kind="led" size={96} />
          <span class="feature__readout mono">{m.landing.readout}</span>
        </div>
        <h3>{m.landing.features[0]?.title}</h3>
        <p>{m.landing.features[0]?.body}</p>
      </article>
      <article class="feature card">
        <div class="feature__art feature__art--hall" aria-hidden="true">
          <div class="feature__shelf">
            <PartIcon kind="led" size={56} state="burned" />
            <PartIcon kind="resistor" size={56} state="burned" />
            <PartIcon kind="fuse" size={56} state="burned" />
          </div>
          <Mascot pose="oops" size={64} className="feature__oops" />
        </div>
        <h3>{m.landing.features[1]?.title}</h3>
        <p>{m.landing.features[1]?.body}</p>
      </article>
      <article class="feature card">
        <div class="feature__art feature__art--bin" aria-hidden="true">
          {binParts.map((k) => <span class="feature__bin-slot"><PartIcon kind={k} size={44} /></span>)}
        </div>
        <h3>{m.landing.features[2]?.title}</h3>
        <p>{m.landing.features[2]?.body}</p>
      </article>
    </div>
  </section>

  <section class="path container" aria-labelledby="path-title">
    <div class="section-head">
      <h2 id="path-title">{m.landing.pathTitle}</h2>
      <p>{m.landing.pathLead}</p>
    </div>
    <ol class="path__list">
      {
        path.map((u) => (
          <li class:list={["path__unit", { "path__unit--soon": !u.open }]}>
            <span class="path__num mono">{u.number}</span>
            <div>
              <h3>{u.title}</h3>
              <p class="small">{u.summary}</p>
            </div>
            {u.open ? <Badge tone="accent">{m.map.state.open}</Badge> : <Badge>{m.common.comingSoon}</Badge>}
          </li>
        ))
      }
    </ol>
  </section>

  <section class="open container" aria-labelledby="open-title">
    <div class="open__card">
      <span class="open__icon"><Icon name="book" size={28} /></span>
      <div>
        <h2 id="open-title">{m.landing.openTitle}</h2>
        <p>{m.landing.openBody}</p>
        <a href="/about" class="open__link">{m.landing.openLink}<Icon name="arrow-right" size={16} /></a>
      </div>
    </div>
  </section>

  <section class="final container" aria-labelledby="final-title">
    <Mascot pose="celebrate" size={128} />
    <h2 id="final-title">{m.landing.finalTitle}</h2>
    <p class="muted">{m.landing.finalBody}</p>
    <HeroActions client:visible outline={course.outline} secondary={false} />
  </section>
</Page>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background-image: radial-gradient(var(--dot-grid) 1.2px, transparent 1.4px);
    background-size: 22px 22px;
    border-bottom: var(--border) solid var(--line);
  }
  .hero::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 120px;
    background: linear-gradient(to bottom, transparent, var(--bg));
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-12);
    min-height: min(680px, calc(100dvh - var(--header-h)));
    padding-block: var(--space-16) var(--space-12);
  }
  .hero__copy { display: grid; gap: var(--space-6); justify-items: start; }
  .hero__title {
    font-size: var(--text-hero);
    line-height: var(--leading-hero);
    letter-spacing: -0.035em;
  }
  .hero__title-accent {
    display: block;
    position: relative;
    width: fit-content;
    color: var(--accent-ink);
  }
  .hero__title-accent::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0.4em;
    bottom: 0.06em;
    height: 0.22em;
    border-radius: var(--radius-full);
    background: var(--glow-soft);
    z-index: -1;
  }
  .hero__lead { font-size: var(--text-lead); line-height: var(--leading-lead); color: var(--ink-2); max-width: 54ch; }
  .hero__reassure { display: inline-flex; align-items: center; gap: var(--space-2); color: var(--ink-2); }
  .hero__isle { position: relative; margin: 0; display: grid; justify-items: center; }
  .hero__isle-glow {
    position: absolute;
    inset: 8% 6% 14% 6%;
    border-radius: var(--radius-full);
    background: radial-gradient(closest-side, var(--glow-soft), transparent);
    filter: blur(8px);
  }
  .hero__isle :global(.hero__isle-art) { position: relative; width: 100%; max-width: 600px; height: auto; }
  .hero__mascot { position: absolute; top: 2%; left: 62%; transform: translateX(-50%); }
  .hero__isle figcaption { position: relative; margin-top: calc(-1 * var(--space-4)); }
  :global(:root[data-motion="full"] .hero__isle-art .isle-art__cloud) { animation: drift var(--dur-drift) var(--ease-in-out) infinite alternate; }
  @keyframes drift { from { transform: translateX(-6px); } to { transform: translateX(8px); } }

  .how { padding-top: var(--space-16); }
  .how__steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
    list-style: none;
  }
  .how__steps::before {
    content: "";
    position: absolute;
    left: 6%;
    right: 6%;
    top: 58px;
    border-top: var(--border-thick) dashed var(--copper);
    opacity: 0.45;
  }
  .how__step { position: relative; display: grid; gap: var(--space-3); align-content: start; }
  .how__num { color: var(--ink-3); font-size: var(--text-small); }
  .how__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-l);
    background: var(--surface);
    border: var(--border) solid var(--line);
    box-shadow: var(--shadow-1);
    color: var(--accent-ink);
  }
  .how__step p { color: var(--ink-2); }

  .features { padding-top: var(--space-20); }
  .features__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
  .feature { display: grid; gap: var(--space-3); align-content: start; padding: var(--space-5); }
  .feature p { color: var(--ink-2); }
  .feature h3 { margin-top: var(--space-2); }
  .feature__art {
    position: relative;
    display: grid;
    place-items: center;
    height: 180px;
    border-radius: var(--radius-m);
    background: var(--surface-sunk);
    background-image: radial-gradient(var(--dot-grid) 1.2px, transparent 1.4px);
    background-size: 16px 16px;
    overflow: hidden;
  }
  .feature__glow { position: absolute; width: 160px; height: 160px; border-radius: var(--radius-full); background: radial-gradient(closest-side, var(--led-red), transparent); opacity: 0.35; transform: translateY(-14px); }
  .feature__art--sim :global(.part-icon) { position: relative; }
  .feature__readout {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-4);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-xs);
    background: var(--lcd);
    color: var(--lcd-ink);
    font-size: var(--text-small);
  }
  .feature__shelf {
    display: flex;
    align-items: flex-end;
    gap: var(--space-3);
    padding: 0 var(--space-4) var(--space-1);
    border-bottom: 6px solid var(--copper);
    transform: translateY(18px);
  }
  .feature__art :global(.feature__oops) { position: absolute; top: var(--space-3); right: var(--space-4); }
  .feature__art--bin { grid-template-columns: repeat(3, 64px); gap: var(--space-3); place-content: center; }
  .feature__bin-slot { display: grid; place-items: center; width: 64px; height: 64px; border-radius: var(--radius-m); background: var(--surface); border: var(--border) solid var(--line); }

  .path { padding-top: var(--space-20); }
  .path__list { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--space-4); list-style: none; }
  .path__unit {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    justify-items: start;
    padding: var(--space-5);
    border-radius: var(--radius-l);
    background: var(--surface);
    border: var(--border) solid var(--line);
  }
  .path__unit h3 { font-size: var(--text-subheading); }
  .path__unit p { color: var(--ink-2); margin-top: var(--space-1); }
  .path__unit--soon { background: transparent; border-style: dashed; }
  .path__unit--soon h3 { color: var(--ink-2); }
  .path__num {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background: var(--primary);
    color: var(--primary-ink);
    font-size: var(--text-small);
  }
  .path__unit--soon .path__num { background: var(--surface-sunk); color: var(--ink-2); }

  .open { padding-top: var(--space-20); }
  .open__card {
    display: flex;
    gap: var(--space-6);
    align-items: flex-start;
    padding: var(--space-10);
    border-radius: var(--radius-xl);
    background: var(--bg-band);
    border: var(--border) solid var(--line);
  }
  .open__card p { margin-top: var(--space-3); color: var(--ink-2); max-width: 64ch; }
  .open__icon { display: grid; place-items: center; flex: none; width: 56px; height: 56px; border-radius: var(--radius-l); background: var(--surface); color: var(--accent-ink); border: var(--border) solid var(--line); }
  .open__link { display: inline-flex; align-items: center; gap: var(--space-2); margin-top: var(--space-4); font-weight: var(--weight-semibold); }

  .final { display: grid; justify-items: center; gap: var(--space-4); padding-top: var(--space-24); text-align: center; }
  .final h2 { font-size: var(--text-title); margin-top: var(--space-2); }

  :global(.hero-actions) { display: flex; flex-wrap: wrap; gap: var(--space-3); }

  @media (max-width: 1020px) {
    .hero__inner { grid-template-columns: 1fr; gap: var(--space-6); min-height: 0; padding-block: var(--space-10) var(--space-8); }
    .hero__isle { order: -1; max-width: 520px; justify-self: center; width: 100%; }
    .how__steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .how__steps::before { display: none; }
    .features__grid { grid-template-columns: 1fr; }
    .path__list { grid-template-columns: 1fr; }
    .path__unit { grid-template-columns: auto 1fr auto; align-items: center; }
  }
  @media (max-width: 767px) {
    .hero__inner { padding-block: var(--space-4) var(--space-8); gap: var(--space-4); }
    .hero__copy { gap: var(--space-4); }
    .hero__isle { max-width: 300px; }
    .hero__isle figcaption { display: none; }
    .hero__mascot :global(svg) { width: 64px; height: 64px; }
    .how { padding-top: var(--space-10); }
    .how__steps { grid-template-columns: 1fr; gap: var(--space-5); }
    .how__step { grid-template-columns: 52px 1fr; column-gap: var(--space-4); row-gap: var(--space-1); }
    .how__num { display: none; }
    .how__icon { grid-row: span 2; }
    .features, .path, .open { padding-top: var(--space-12); }
    .open__card { flex-direction: column; padding: var(--space-6); }
    .path__unit { grid-template-columns: auto 1fr; }
    .path__unit :global(.badge) { grid-column: 2; }
    .final { padding-top: var(--space-16); }
  }
</style>

---
import Page from "../layouts/Page.astro";
import { Button } from "../components/Button";
import { PartIcon } from "../parts/PartIcon";
import { Mascot } from "../mascot/Mascot";
import { m } from "../i18n";
---

<Page title={m.notFound.title}>
  <section class="nf container">
    <div class="nf__art" aria-hidden="true">
      <PartIcon kind="led" size={160} state="burned" />
      <Mascot pose="oops" size={112} />
    </div>
    <h1>{m.notFound.title}</h1>
    <p class="lead">{m.notFound.body}</p>
    <Button variant="primary" size="large" href="/learn" iconEnd="arrow-right">{m.notFound.cta}</Button>
  </section>
</Page>

<style>
  .nf { display: grid; justify-items: center; gap: var(--s-4); padding-top: var(--s-16); text-align: center; }
  .nf__art { display: flex; align-items: flex-end; gap: var(--s-6); margin-bottom: var(--s-4); }
  .nf h1 { font-size: var(--text-3xl); line-height: var(--lh-3xl); letter-spacing: var(--track-title); }
  .nf .lead { margin-inline: auto; margin-bottom: var(--s-4); }
  @media (max-width: 720px) {
    .nf h1 { font-size: var(--text-2xl); line-height: var(--lh-2xl); }
  }
</style>

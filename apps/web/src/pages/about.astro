---
import Page from "../layouts/Page.astro";
import { m } from "../i18n";
---

<Page title={m.about.title}>
  <div class="sheet">
    <div class="sheet__main about">
      <header class="page-head">
        <h1>{m.about.title}</h1>
        <p class="lead">{m.about.lead}</p>
      </header>
      <dl class="about__list">
        {
          m.about.sections.map((s) => (
            <div class="about__row">
              <dt>{s.title}</dt>
              <dd>{s.body}</dd>
            </div>
          ))
        }
      </dl>
      <section class="about__reading" aria-labelledby="about-reading">
        <h2 id="about-reading" class="kicker">{m.about.readingTitle}</h2>
        <ul>
          {
            m.about.reading.map((b) => (
              <li>
                <i>{b.title}</i>, <span class="muted">{b.by}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</Page>

<style>
  .about { max-width: var(--text-col); }
  .about__list { border-top: var(--border-1) solid var(--rule); }
  .about__row { display: grid; grid-template-columns: 9em minmax(0, 1fr); gap: var(--s-6); padding: var(--s-4) 0; border-bottom: var(--border-1) solid var(--rule-soft); }
  .about__row dt { font-weight: var(--weight-strong); }
  .about__row dd { color: var(--ink-2); }
  .about__reading { display: grid; gap: var(--s-3); margin-top: var(--s-12); }
  .about__reading ul { display: grid; gap: var(--s-2); list-style: none; }
  @media (max-width: 720px) {
    .about__row { grid-template-columns: minmax(0, 1fr); gap: var(--s-1); }
  }
</style>

---
/** The free-build bench: the lab runtime with no tasks, the learner's unlocked parts in the tray. */
import Page from "../layouts/Page.astro";
import Sandbox from "../lab/Sandbox";
import { getCourse } from "../content/load";
import { m } from "../i18n";

const course = getCourse();
const first = course.lessons[0];
---

<Page title={m.bench.title} description={m.bench.lead} active="bench" bodyClass="bench-page" footer={false}>
  <h1 class="sr-only">{m.bench.title}</h1>
  <div class="sandbox-host">
    <Sandbox client:only="react" outline={course.outline} firstHref={first?.href ?? "/learn"}>
      <div slot="fallback" class="sandbox-loading" role="status" aria-label={m.lab.loading}>
        <span class="sandbox-loading__line">{m.lab.loadingBench}</span>
      </div>
    </Sandbox>
  </div>
</Page>

<style>
  /* The bench fills the window under the site header (and above the bottom bar on phones). */
  .sandbox-host { height: calc(100dvh - var(--header-h) - var(--border-1)); min-height: 520px; }
  .sandbox-host :global(.sandbox-loading) { display: grid; place-items: center; height: 100%; }
  .sandbox-loading__line { color: var(--ink-2); font-size: var(--text-sm); }
  @media (max-width: 720px) {
    .sandbox-host { height: calc(100dvh - 56px - var(--bar-h)); }
  }
</style>

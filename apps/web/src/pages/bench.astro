---
/** The free-build bench: the lab runtime with no tasks, the learner's unlocked parts in the tray. */
import Page from "../layouts/Page.astro";
import Sandbox from "../lab/Sandbox";
import { getCourse } from "../content/load";
import { m } from "../i18n";

const course = getCourse();
const first = course.lessons[0];
---

<Page title={m.bench.title} description={m.bench.lead} active="bench" bodyClass="bench-page">
  <h1 class="sr-only">{m.bench.title}</h1>
  <div class="sandbox-host">
    <Sandbox client:only="react" outline={course.outline} firstHref={first?.href ?? "/learn"}>
      <div slot="fallback" class="sandbox-loading skeleton" role="status" aria-label={m.lab.loading}></div>
    </Sandbox>
  </div>
</Page>

<style>
  /* The bench fills the window under the site header (and above the bottom navigation on phones). */
  .sandbox-host {
    height: calc(100dvh - var(--header-h));
    min-height: 520px;
  }
  .sandbox-host :global(.sandbox-loading) { display: block; height: 100%; border-radius: 0; }
  @media (max-width: 860px) {
    .sandbox-host { height: calc(100dvh - var(--header-h) - var(--bottom-nav-h)); }
  }
  :global(body.bench-page .site-footer) { display: none; }
</style>

---
import Page from "../../layouts/Page.astro";
import CourseMap from "../../components/CourseMap";
import { getCourse } from "../../content/load";
import { mapOf } from "../../content/map";
import { m } from "../../i18n";

const course = getCourse();
const map = mapOf(course);
---

<Page title={m.map.title} active="learn">
  <CourseMap client:load units={map.units} upcoming={map.upcoming} outline={course.outline} />
</Page>

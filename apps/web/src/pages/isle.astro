---
/** The learner's island, full screen. No site header or bottom bar: the page's own top bar closes it. */
import Base from "../layouts/Base.astro";
import IslePage from "../isle/IslePage";
import ToastRegion from "../components/ToastRegion";
import { getCourse } from "../content/load";
import { m } from "../i18n";

const course = getCourse();
---

<Base title={m.isle.title} description={m.isle.lead} bodyClass="isle-body">
  <IslePage client:load outline={course.outline} />
  <ToastRegion client:idle />
</Base>

---
import Page from "../layouts/Page.astro";
import { AchievementGrid, HallOfFriedParts, LevelLine } from "../components/AchievementsView";
import { getCourse } from "../content/load";
import { m } from "../i18n";

const course = getCourse();
const firstLab = course.lessons.find((l) => l.format === "bench" || l.steps.some((s) => s.type === "lab"));
---

<Page title={m.achievements.title} active="achievements">
  <div class="sheet">
    <div class="sheet__main ach-page">
      <header class="page-head">
        <h1>{m.achievements.title}</h1>
        <LevelLine client:load outline={course.outline} />
      </header>
      <AchievementGrid client:load outline={course.outline} />
      <HallOfFriedParts client:load outline={course.outline} firstLabHref={firstLab?.href ?? "/learn"} />
    </div>
  </div>
</Page>

<style>
  .ach-page { display: grid; gap: var(--s-16); }
  .ach-page .page-head { padding-bottom: 0; }
</style>

---
/**
 * The document shell for every page: meta, fonts, design tokens and the head script that applies the learner's theme
 * and motion choice before the first paint.
 */
// Literata typesets everything; Kalam writes the marginalia. Each subset downloads only when the page uses its
// characters (Ω pulls in Literata's Greek one; Kalam has no Greek, so Ω in handwriting falls back to Literata).
import "@fontsource/literata/400.css";
import "@fontsource/literata/400-italic.css";
import "@fontsource/literata/600.css";
import "@fontsource/literata/700.css";
import "@fontsource/kalam/latin-400.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/components.css";
import literataLatin from "@fontsource/literata/files/literata-latin-400-normal.woff2?url";
import literataLatinStrong from "@fontsource/literata/files/literata-latin-600-normal.woff2?url";
import { HEAD_SCRIPT } from "../progress/prefs";
import { m, lang } from "../i18n";

type Props = { title?: string; description?: string; bodyClass?: string };
const { title, description = m.meta.description, bodyClass } = Astro.props;
const fullTitle = title ? `${title} · ${m.meta.titleSuffix}` : `${m.meta.siteName}: ${m.meta.tagline}`;
---

<!doctype html>
<html lang={lang} data-motion="full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={literataLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={literataLatinStrong} as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline set:html={HEAD_SCRIPT} />
  </head>
  <body class={bodyClass}>
    <slot />
    <script>
      // Signed-in learners sync from every page; for a guest this is one localStorage read (src/account/boot.ts).
      import { boot } from "../account/boot";
      boot();
    </script>
  </body>
</html>

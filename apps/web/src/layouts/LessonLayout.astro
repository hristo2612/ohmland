---
/** Focus mode for lessons: no site header or footer, only the player and the toast region. */
import Base from "./Base.astro";
import ToastRegion from "../components/ToastRegion";

type Props = { title: string; description?: string; noindex?: boolean };
const { title, description, noindex } = Astro.props;
---

<Base title={title} description={description} bodyClass="lesson-page" noindex={noindex}>
  <slot />
  <ToastRegion client:idle />
</Base>

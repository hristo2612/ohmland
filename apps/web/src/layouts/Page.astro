---
/**
 * The shell for regular pages: a header with the wordmark, the two places (Learn, Isle) and your notebook (level, XP
 * and the one menu for the rest); the page; one quiet footer line; on phones a bottom bar (not on the landing, whose
 * poster is the whole screen); and the toast region.
 */
import Base from "./Base.astro";
import Logo from "../components/Logo.astro";
import HeaderTools from "../components/HeaderTools";
import BottomNav from "../components/BottomNav";
import ToastRegion from "../components/ToastRegion";
import { NAV, type NavId } from "../components/nav";
import { getCourse } from "../content/load";
import { m } from "../i18n";
import "../styles/layout.css";

type Props = {
  title?: string;
  description?: string;
  active?: NavId | undefined;
  bodyClass?: string;
  /** No rule under the header (the landing's poster owns the page). */
  bare?: boolean;
  /** Leave out the footer (full-window pages such as the bench). */
  footer?: boolean;
  /** The phone's bottom bar (left out on the landing, as on lesson pages). */
  bar?: boolean;
};
const { title, description, active, bodyClass, bare = false, footer = true, bar = true } = Astro.props;
const { outline } = getCourse();
---

<Base title={title} description={description} bodyClass={[bar && "has-bottom-nav", bodyClass].filter(Boolean).join(" ")}>
  <a class="skip-link" href="#main">{m.common.skipToContent}</a>
  <div class="leaf">
  <header class:list={["site-header", { "site-header--bare": bare }]}>
    <div class="site-header__inner container">
      <Logo />
      <nav class="site-nav" aria-label={m.nav.label}>
        <ul>
          {
            NAV.map((n) => (
              <li>
                <a href={n.href} class="site-nav__link" aria-current={active === n.id ? "page" : undefined}>
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <HeaderTools client:idle outline={outline} active={active} />
    </div>
  </header>

  <main id="main" tabindex="-1">
    <slot />
  </main>

  {
    footer && (
      <footer class="site-footer">
        <div class="container site-footer__inner">
          <p>{m.footer.line}</p>
          <ul class="site-footer__links">
            <li>
              <a href="/about">{m.footer.about}</a>
            </li>
            <li>{m.footer.licenses}</li>
          </ul>
        </div>
      </footer>
    )
  }
  </div>

  {bar && <BottomNav client:idle outline={outline} active={active} />}

  <ToastRegion client:idle />
</Base>
